---
import Base from '../layouts/Base.astro';
import { site } from '../site';
const base = import.meta.env.BASE_URL;
---
<Base title="关于我"><a class="back" href={base}>← 返回文章</a><span class="eyebrow">About</span><h1 class="page-title">关于我</h1><div class="about-card prose">{site.about.map(p => <p>{p}</p>)}</div></Base>
