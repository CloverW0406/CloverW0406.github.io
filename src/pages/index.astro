---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site';
const posts = (await getCollection('posts', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
---
<Base title="文章">
  <section class="intro"><span class="eyebrow">Personal journal</span><h1>{site.greeting}<br /><span class="hero-name">{site.name}</span><span class="hero-stop">。</span></h1><p>{site.description}</p></section>
  <section>
    <div class="section-heading"><h2>最近的文章</h2><input id="search" class="search" type="search" placeholder="搜索文章…" aria-label="搜索文章" /></div>
    <div class="post-list">
      {posts.map(post => <a class="post-row" href={`${base}posts/${post.id}/`} data-search={`${post.data.title} ${post.data.summary} ${post.data.category} ${post.body}`}>
        <div class="post-top"><h3>{post.data.title}</h3><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time></div>
        <p>{post.data.summary}</p><span class="tag">{post.data.category}</span>
      </a>)}
    </div>
    <p id="empty" class="empty" hidden={posts.length > 0}>暂无文章。新的笔记会出现在这里。</p>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#search');
    const rows = [...document.querySelectorAll<HTMLElement>('.post-row')];
    const empty = document.querySelector<HTMLElement>('#empty');
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLocaleLowerCase();
      let count = 0;
      for (const row of rows) {const show = (row.dataset.search ?? '').toLocaleLowerCase().includes(q);row.hidden = !show;if(show) count++;}
      if (empty) empty.hidden = count !== 0;
    });
  </script>
</Base>
